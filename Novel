<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>In The Quiet Between Heartbeats</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap" rel="stylesheet">
    <style>
        :root {
            --cream: #FAF6F1;
            --warm-cream: #F5EDE4;
            --beige: #E8DDD3;
            --soft-beige: #D4C5B5;
            --burgundy: #6B2737;
            --deep-burgundy: #4A1A27;
            --dark-burgundy: #3A1420;
            --gold: #C4A265;
            --soft-gold: #D4B87A;
            --light-gold: #E8D5A8;
            --text-dark: #2C1810;
            --text-medium: #5A3E35;
            --text-light: #8B7265;
            --text-subtle: #B8A89D;
            --page-number: #C4B5A8;
            --rose: #C4898A;
            --soft-rose: #D4A5A6;
            --blush: #E8C5C0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-snap-type: y mandatory;
            overflow-y: scroll;
            overflow-x: hidden;
        }

        body {
            background: #1a1210;
            font-family: 'Cormorant Garamond', 'Lora', Georgia, serif;
            color: var(--text-dark);
            cursor: default;
        }

        /* Navigation */
        .nav-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background: linear-gradient(180deg, rgba(26,18,16,0.9) 0%, rgba(26,18,16,0) 100%);
            transition: all 0.5s ease;
        }

        .nav-bar.scrolled {
            background: rgba(26,18,16,0.95);
            backdrop-filter: blur(20px);
            padding: 10px 40px;
        }

        .nav-title {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            color: var(--soft-gold);
            font-size: 14px;
            letter-spacing: 1px;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .nav-bar.scrolled .nav-title {
            opacity: 1;
        }

        .nav-controls {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .nav-btn {
            background: rgba(196,162,101,0.15);
            border: 1px solid rgba(196,162,101,0.3);
            color: var(--soft-gold);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all 0.3s ease;
            font-family: 'Cormorant Garamond', serif;
        }

        .nav-btn:hover {
            background: rgba(196,162,101,0.3);
            border-color: var(--soft-gold);
            transform: scale(1.1);
        }

        .slide-counter {
            color: var(--page-number);
            font-family: 'Cormorant Garamond', serif;
            font-size: 13px;
            letter-spacing: 2px;
            min-width: 50px;
            text-align: center;
        }

        .toc-btn {
            background: rgba(196,162,101,0.15);
            border: 1px solid rgba(196,162,101,0.3);
            color: var(--soft-gold);
            padding: 6px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-family: 'Cormorant Garamond', serif;
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .toc-btn:hover {
            background: rgba(196,162,101,0.3);
            border-color: var(--soft-gold);
        }

        /* Progress bar */
        .progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--burgundy), var(--gold), var(--burgundy));
            z-index: 1001;
            transition: width 0.3s ease;
            box-shadow: 0 0 10px rgba(196,162,101,0.5);
        }

        /* Slide base */
        .slide {
            width: 100vw;
            height: 100vh;
            scroll-snap-align: start;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .page-number {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Cormorant Garamond', serif;
            font-size: 13px;
            color: var(--page-number);
            letter-spacing: 3px;
            z-index: 10;
        }

        .chapter-label {
            position: absolute;
            top: 40px;
            right: 50px;
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 12px;
            color: var(--text-subtle);
            letter-spacing: 2px;
            text-transform: uppercase;
            z-index: 10;
        }

        /* ==================== */
        /* COVER PAGE - Slide 1 */
        /* ==================== */
        .slide-cover {
            background: var(--dark-burgundy);
            position: relative;
        }

        .cover-bg {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse at 30% 50%, rgba(107,39,55,0.4) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 30%, rgba(196,162,101,0.1) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 80%, rgba(74,26,39,0.6) 0%, transparent 50%);
        }

        .cover-texture {
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            opacity: 0.5;
        }

        .cover-border {
            position: absolute;
            inset: 30px;
            border: 1px solid rgba(196,162,101,0.2);
            pointer-events: none;
        }

        .cover-border::before {
            content: '';
            position: absolute;
            inset: 8px;
            border: 1px solid rgba(196,162,101,0.1);
        }

        .cover-corner {
            position: absolute;
            width: 40px;
            height: 40px;
            border-color: var(--gold);
            opacity: 0.5;
        }

        .cover-corner.tl { top: 25px; left: 25px; border-top: 2px solid; border-left: 2px solid; }
        .cover-corner.tr { top: 25px; right: 25px; border-top: 2px solid; border-right: 2px solid; }
        .cover-corner.bl { bottom: 25px; left: 25px; border-bottom: 2px solid; border-left: 2px solid; }
        .cover-corner.br { bottom: 25px; right: 25px; border-bottom: 2px solid; border-right: 2px solid; }

        .cover-content {
            position: relative;
            z-index: 5;
            text-align: center;
            padding: 40px;
        }

        .cover-ornament {
            width: 60px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 0 auto 40px;
        }

        .cover-subtitle-top {
            font-family: 'Cormorant Garamond', serif;
            font-size: 13px;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: var(--soft-gold);
            margin-bottom: 50px;
            opacity: 0.7;
        }

        .cover-title {
            font-family: 'Playfair Display', serif;
            font-weight: 400;
            color: var(--cream);
            margin-bottom: 10px;
        }

        .cover-title .line1 {
            font-size: 22px;
            font-style: italic;
            letter-spacing: 4px;
            display: block;
            margin-bottom: 15px;
            color: var(--soft-gold);
            opacity: 0.8;
        }

        .cover-title .line2 {
            font-size: 62px;
            letter-spacing: 2px;
            display: block;
            line-height: 1.1;
            margin-bottom: 8px;
        }

        .cover-title .line3 {
            font-size: 62px;
            font-style: italic;
            letter-spacing: 2px;
            display: block;
            line-height: 1.1;
        }

        .cover-divider {
            width: 100px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 40px auto;
        }

        .cover-tagline {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 18px;
            color: var(--blush);
            letter-spacing: 3px;
            margin-bottom: 50px;
        }

        .cover-author {
            font-family: 'Cormorant Garamond', serif;
            font-size: 14px;
            letter-spacing: 5px;
            text-transform: uppercase;
            color: var(--soft-gold);
            opacity: 0.6;
        }

        .cover-roses {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0.06;
            font-size: 200px;
            color: var(--gold);
        }

        /* Floating particles */
        .particles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: var(--gold);
            border-radius: 50%;
            opacity: 0;
            animation: floatUp 8s infinite;
        }

        @keyframes floatUp {
            0% { opacity: 0; transform: translateY(100vh) scale(0); }
            20% { opacity: 0.6; }
            80% { opacity: 0.3; }
            100% { opacity: 0; transform: translateY(-20vh) scale(1); }
        }

        /* ==================== */
        /* IMAGE SLIDES */
        /* ==================== */
        .slide-image {
            background: var(--text-dark);
        }

        .image-placeholder {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .image-scene {
            width: 100%;
            height: 100%;
            position: relative;
        }

        /* Scene 1: Couple Silhouette Sunset */
        .scene-sunset {
            background: linear-gradient(180deg, 
                #2C1810 0%, 
                #4A1A27 15%,
                #6B2737 30%, 
                #C4898A 50%, 
                #E8D5A8 65%,
                #D4B87A 75%,
                #C4A265 85%,
                #E8DDD3 100%
            );
        }

        .scene-sunset::before {
            content: '';
            position: absolute;
            bottom: 25%;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(232,213,168,0.8) 0%, rgba(196,162,101,0.4) 40%, transparent 70%);
            border-radius: 50%;
        }

        .silhouette-couple {
            position: absolute;
            bottom: 22%;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
        }

        .silhouette-couple svg {
            width: 180px;
            height: 250px;
            fill: #1a1210;
            opacity: 0.85;
        }

        /* Scene 2: Warm Light Window */
        .scene-warm-light {
            background: linear-gradient(135deg, 
                #2C1810 0%, 
                #3A1420 30%,
                #4A1A27 60%, 
                #6B2737 100%
            );
        }

        .scene-warm-light .light-source {
            position: absolute;
            top: 30%;
            right: 20%;
            width: 300px;
            height: 400px;
            background: radial-gradient(ellipse, rgba(232,213,168,0.15) 0%, transparent 70%);
        }

        /* Scene: Nature Morning */
        .scene-nature {
            background: linear-gradient(180deg,
                #FAF6F1 0%,
                #F5EDE4 20%,
                #E8DDD3 40%,
                #D4C5B5 60%,
                #C4A265 80%,
                #6B2737 100%
            );
        }

        /* Scene: Rainy Window */
        .scene-rain {
            background: linear-gradient(180deg,
                #2C1810 0%,
                #3A1420 40%,
                #4A1A27 70%,
                #5A3E35 100%
            );
        }

        .rain-drops {
            position: absolute;
            inset: 0;
            overflow: hidden;
        }

        .rain-drop {
            position: absolute;
            width: 2px;
            background: linear-gradient(180deg, transparent, rgba(250,246,241,0.1));
            animation: rain 1.5s linear infinite;
        }

        @keyframes rain {
            0% { transform: translateY(-100%); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translateY(100vh); opacity: 0; }
        }

        /* Scene: Soft Focus Flowers */
        .scene-flowers {
            background: linear-gradient(135deg,
                #FAF6F1 0%,
                #E8C5C0 30%,
                #D4A5A6 50%,
                #C4898A 70%,
                #6B2737 100%
            );
        }

        .bokeh-circles {
            position: absolute;
            inset: 0;
        }

        .bokeh {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(250,246,241,0.15) 0%, transparent 70%);
        }

        /* Scene: Starry Night */
        .scene-stars {
            background: linear-gradient(180deg,
                #1a1210 0%,
                #2C1810 40%,
                #3A1420 70%,
                #4A1A27 100%
            );
        }

        .star {
            position: absolute;
            width: 2px;
            height: 2px;
            background: var(--cream);
            border-radius: 50%;
            animation: twinkle 3s ease-in-out infinite alternate;
        }

        @keyframes twinkle {
            0% { opacity: 0.2; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1.2); }
        }

        /* Scene: Autumn Leaves */
        .scene-autumn {
            background: linear-gradient(180deg,
                #FAF6F1 0%,
                #E8D5A8 30%,
                #D4B87A 50%,
                #C4A265 70%,
                #6B2737 100%
            );
        }

        /* Scene: Ocean */
        .scene-ocean {
            background: linear-gradient(180deg,
                #D4A5A6 0%,
                #C4898A 20%,
                #B8A89D 40%,
                #8B7265 60%,
                #5A3E35 80%,
                #2C1810 100%
            );
        }

        /* Scene: Morning Coffee */
        .scene-morning {
            background: linear-gradient(135deg,
                #FAF6F1 0%,
                #F5EDE4 30%,
                #E8DDD3 50%,
                #D4C5B5 70%,
                #C4A265 100%
            );
        }

        /* Scene: Candlelight */
        .scene-candle {
            background: radial-gradient(ellipse at 50% 50%,
                #C4A265 0%,
                #6B2737 30%,
                #4A1A27 50%,
                #3A1420 70%,
                #2C1810 100%
            );
        }

        .candle-glow {
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(232,213,168,0.3) 0%, transparent 70%);
            animation: flicker 3s ease-in-out infinite alternate;
        }

        @keyframes flicker {
            0% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
            50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
            100% { opacity: 0.85; transform: translate(-50%, -50%) scale(0.98); }
        }

        /* Scene: Garden Path */
        .scene-garden {
            background: linear-gradient(180deg,
                #E8C5C0 0%,
                #F5EDE4 20%,
                #E8DDD3 40%,
                #D4C5B5 60%,
                #B8A89D 80%,
                #6B2737 100%
            );
        }

        /* Scene: First Snow */
        .scene-snow {
            background: linear-gradient(180deg,
                #FAF6F1 0%,
                #E8DDD3 30%,
                #D4C5B5 50%,
                #B8A89D 70%,
                #8B7265 100%
            );
        }

        .snowflake {
            position: absolute;
            width: 4px;
            height: 4px;
            background: white;
            border-radius: 50%;
            opacity: 0.6;
            animation: snowfall 6s linear infinite;
        }

        @keyframes snowfall {
            0% { transform: translateY(-10%) translateX(0); opacity: 0; }
            10% { opacity: 0.6; }
            90% { opacity: 0.4; }
            100% { transform: translateY(110vh) translateX(50px); opacity: 0; }
        }

        /* Scene: Hands */
        .scene-hands {
            background: linear-gradient(180deg,
                #3A1420 0%,
                #6B2737 30%,
                #C4898A 60%,
                #E8DDD3 100%
            );
        }

        /* Scene: Bookshelf */
        .scene-books {
            background: linear-gradient(135deg,
                #2C1810 0%,
                #5A3E35 40%,
                #8B7265 70%,
                #D4C5B5 100%
            );
        }

        /* Scene: Dancing */
        .scene-dance {
            background: radial-gradient(ellipse at center,
                #6B2737 0%,
                #4A1A27 40%,
                #3A1420 60%,
                #2C1810 100%
            );
        }

        /* Scene: Horizon */
        .scene-horizon {
            background: linear-gradient(180deg,
                #C4898A 0%,
                #D4A5A6 15%,
                #E8C5C0 30%,
                #E8D5A8 50%,
                #D4B87A 65%,
                #C4A265 80%,
                #6B2737 100%
            );
        }

        .image-caption {
            position: absolute;
            bottom: 60px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 14px;
            color: rgba(250,246,241,0.5);
            letter-spacing: 2px;
            white-space: nowrap;
            z-index: 10;
        }

        .image-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, 
                rgba(26,18,16,0.3) 0%, 
                transparent 30%,
                transparent 70%,
                rgba(26,18,16,0.4) 100%
            );
            z-index: 5;
        }

        .image-vignette {
            position: absolute;
            inset: 0;
            box-shadow: inset 0 0 150px rgba(26,18,16,0.5);
            z-index: 6;
        }

        /* ==================== */
        /* TEXT SLIDES */
        /* ==================== */
        .slide-text {
            background: var(--cream);
        }

        .text-content {
            max-width: 680px;
            padding: 80px 60px;
            position: relative;
        }

        .text-content .chapter-num {
            font-family: 'Playfair Display', serif;
            font-size: 11px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 10px;
            opacity: 0.7;
        }

        .text-content .chapter-title {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 400;
            color: var(--burgundy);
            line-height: 1.3;
            margin-bottom: 40px;
        }

        .text-content .chapter-title em {
            font-style: italic;
            color: var(--deep-burgundy);
        }

        .text-content .text-ornament {
            width: 50px;
            height: 1px;
            background: linear-gradient(90deg, var(--gold), transparent);
            margin-bottom: 35px;
        }

        .text-content p {
            font-family: 'Cormorant Garamond', serif;
            font-size: 19px;
            line-height: 1.9;
            color: var(--text-medium);
            margin-bottom: 25px;
            font-weight: 400;
        }

        .text-content p:last-of-type {
            margin-bottom: 0;
        }

        .text-content .placeholder {
            font-style: italic;
            color: var(--rose);
            background: rgba(196,137,138,0.08);
            padding: 3px 8px;
            border-radius: 3px;
            border-bottom: 1px dashed var(--soft-rose);
        }

        .text-content .emphasis {
            font-style: italic;
            color: var(--burgundy);
        }

        .text-content .pull-quote {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 24px;
            color: var(--burgundy);
            line-height: 1.6;
            padding: 30px 0;
            margin: 10px 0;
            border-top: 1px solid rgba(196,162,101,0.3);
            border-bottom: 1px solid rgba(196,162,101,0.3);
            text-align: center;
        }

        .text-content .signature {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 22px;
            color: var(--burgundy);
            margin-top: 30px;
        }

        .text-content .small-text {
            font-size: 15px;
            color: var(--text-light);
            letter-spacing: 0.5px;
        }

        /* ==================== */
        /* TITLE PAGE - Slide 2 */
        /* ==================== */
        .slide-title-page {
            background: var(--cream);
        }

        .title-page-content {
            text-align: center;
            padding: 60px;
        }

        .title-page-content .tp-ornament-top {
            width: 80px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 0 auto 60px;
        }

        .title-page-content .tp-title {
            font-family: 'Playfair Display', serif;
            font-weight: 400;
            margin-bottom: 30px;
        }

        .title-page-content .tp-title .tp-line1 {
            font-size: 16px;
            font-style: italic;
            letter-spacing: 3px;
            color: var(--text-light);
            display: block;
            margin-bottom: 15px;
        }

        .title-page-content .tp-title .tp-line2 {
            font-size: 48px;
            color: var(--burgundy);
            display: block;
            line-height: 1.2;
            margin-bottom: 5px;
        }

        .title-page-content .tp-title .tp-line3 {
            font-size: 48px;
            font-style: italic;
            color: var(--deep-burgundy);
            display: block;
            line-height: 1.2;
        }

        .title-page-content .tp-divider {
            width: 40px;
            height: 1px;
            background: var(--gold);
            margin: 40px auto;
        }

        .title-page-content .tp-written {
            font-family: 'Cormorant Garamond', serif;
            font-size: 15px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--text-light);
            margin-bottom: 10px;
        }

        .title-page-content .tp-author {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 22px;
            color: var(--burgundy);
            margin-bottom: 50px;
        }

        .title-page-content .tp-for {
            font-family: 'Cormorant Garamond', serif;
            font-size: 14px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--text-subtle);
            margin-bottom: 8px;
        }

        .title-page-content .tp-recipient {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 26px;
            color: var(--gold);
        }

